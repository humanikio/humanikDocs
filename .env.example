# Base URL the API reference documents.
#
# Injected into the OpenAPI spec's `servers` at load time, and into the setup
# snippet on every guide page. The spec files in openapi/ carry no host of their
# own, so changing this one value moves the reference, the playground, every
# generated cURL sample, and the `export HOS_API=` line readers copy.
#
# Same variable name hos-frontend uses, so it can be set the same way.
NEXT_PUBLIC_HOS_API_URL=https://hos-api-1.onrender.com/api/v1

# Optional second server, offered in the playground's server picker.
NEXT_PUBLIC_HOS_API_URL_LOCAL=http://localhost:6070/api/v1
